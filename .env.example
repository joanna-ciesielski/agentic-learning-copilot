# Copy to .env for real (non-offline) runs. Offline dev/test needs none of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding backend: "hashing" (offline, default in tests) or "openai".
EMBEDDER=hashing

# Optional: LangSmith / PostHog observability (Phase 4).
LANGSMITH_API_KEY=
POSTHOG_API_KEY=
